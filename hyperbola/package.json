{
  "name": "meu-exchange-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "dev:web": "astro dev",
    "build:web": "astro build",
    "check": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "lint": "npm run check",
    "format": "prettier --write package.json .prettierrc.json",
    "format:check": "prettier --check package.json .prettierrc.json"
  },
  "dependencies": {
    "@hashgraph/asset-tokenization-sdk": "^1.17.0",
    "@hono/node-server": "^1.13.7",
    "@noble/curves": "^1.9.7",
    "hono": "^4.6.14",
    "js-sha3": "^0.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "astro": "^5.14.3",
    "prettier": "^3.6.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
