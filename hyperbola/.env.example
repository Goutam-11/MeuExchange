# demo is safe for local development; testnet sends signed ATS operations.
MODE=demo
PORT=3000

# Protect /api/* when set. Keep this secret outside the repository.
API_ACCESS_TOKEN=

# Durable JSON state path used by the server.
STATE_FILE=./var/meu-state.json

# Required only when MODE=testnet. MEU Exchange never stores signing keys.
ATS_RESOLVER_ADDRESS=0.0.7707874
ATS_FACTORY_ADDRESS=0.0.7708432
HEDERA_MIRROR_NODE=https://testnet.mirrornode.hedera.com/api/v1/
HEDERA_RPC_NODE=https://testnet.hashio.io/api
