---
import "../styles/dashboard.css";
import Sidebar from "../components/dashboard/Sidebar.astro";
import DashboardHeader from "../components/dashboard/DashboardHeader.astro";
import DashboardAlert from "../components/dashboard/DashboardAlert.astro";
import OverviewPanel from "../components/dashboard/OverviewPanel.astro";
import AtsPanel from "../components/dashboard/AtsPanel.astro";
import MeuPanel from "../components/dashboard/MeuPanel.astro";
import IntentsPanel from "../components/dashboard/IntentsPanel.astro";
import WalletDialog from "../components/dashboard/WalletDialog.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="MEU Exchange operations dashboard for ATS-backed RWA workflows on Hedera Testnet."
    />
    <link
      rel="preload"
      href="/fonts/dm-sans.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>MEU Exchange — Dashboard</title>
  </head>
  <body>
    <a class="dash-skip" href="#dashboard-content">Skip to dashboard</a>
    <div class="dashboard-shell">
      <Sidebar />

      <main class="dashboard-main" id="dashboard-content">
        <DashboardHeader />

        <DashboardAlert />

        <div class="tab-panels">
          <OverviewPanel />
          <AtsPanel />
          <MeuPanel />
          <IntentsPanel />
        </div>
      </main>
    </div>
    <WalletDialog />
    <script>
      import { dashboardReady } from "../scripts/dashboard";
      void dashboardReady;
    </script>
  </body>
</html>
